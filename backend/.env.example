# ==============================================================================
# HIREIQ BACKEND CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual values:
#   Local:      ENV=local, FRONTEND_URL=http://localhost:5173
#   Production: ENV=production, FRONTEND_URL=https://hireiq.co.in
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. CORE ENVIRONMENT & SERVER
# ──────────────────────────────────────────────────────────────────────────────
# Environment: 'local' for local development, 'production' for live deployment
ENV=local

# Frontend client URL (used for CORS and link generation in emails)
# Local: http://localhost:5173
# Production: https://hireiq.co.in
FRONTEND_URL=http://localhost:5173

# Optional: Path prefix if FastAPI is served behind a reverse proxy (e.g. /api)
FASTAPI_ROOT_PATH=

# Reverse Proxy: Set to true if behind AWS ALB / Nginx / Cloudflare
TRUST_PROXY_HEADERS=false

# Optional CORS regex (e.g. ^https?://.*\.hireiq\.co\.in$)
CORS_ORIGIN_REGEX=

# Brand name displayed in communications and payment metadata
APP_BRAND_NAME="Hire IQ"


# ──────────────────────────────────────────────────────────────────────────────
# 2. DATABASE & CACHING
# ──────────────────────────────────────────────────────────────────────────────
# MongoDB Connection URI
# Local: mongodb://localhost:27017/hireiq
# Production: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# Redis Cache & Session Store
# Local: redis://localhost:6379/0
# Production: rediss://:<password>@<elasticache-endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0


# ──────────────────────────────────────────────────────────────────────────────
# 3. FIREBASE ADMIN SDK (AUTHENTICATION & VERIFICATION)
# ──────────────────────────────────────────────────────────────────────────────
# SECURITY NOTE: DO NOT commit firebase_credentials.json to GitHub. It is in .gitignore.
# Choose ONE of the following methods to supply Firebase Admin credentials directly via .env:
#
# Method A (Single-line JSON in .env or AWS Secrets Manager - Recommended):
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
#
# Method B (Base64 encoded JSON string - Great for strict single-line .env files):
# FIREBASE_CREDENTIALS_BASE64=
#
# Method C (Individual environment variables in .env):
# FIREBASE_PROJECT_ID=ai-adaptive-interview
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ai-adaptive-interview.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Method D (Local file fallback):
GOOGLE_APPLICATION_CREDENTIALS=firebase_credentials.json


# ──────────────────────────────────────────────────────────────────────────────
# 4. SECURITY & AUTHENTICATION
# ──────────────────────────────────────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production


# ──────────────────────────────────────────────────────────────────────────────
# 5. AI & LLM PROVIDERS
# ──────────────────────────────────────────────────────────────────────────────
# Primary Groq API Key (Fast interview generation & real-time responses)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Comma-separated keys for automatic load balancing across keys
# GROQ_API_KEYS="key1,key2,key3"

# Optional: Groq model (Default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter API Key (Fallback LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (Optional resume parsing / evaluation fallback)
GEMINI_API_KEY=your_gemini_api_key_here


# ──────────────────────────────────────────────────────────────────────────────
# 6. TEXT-TO-SPEECH (TTS) & VOICE MEDIA
# ──────────────────────────────────────────────────────────────────────────────
# Cartesia API Key (Ultra-low latency conversational AI voice)
CARTESIA_API_KEY=your_cartesia_api_key_here

# Default Cartesia Voice ID
CARTESIA_VOICE_ID=651f346b-61cd-4d5c-975b-dfe65bc51f2d

# Optional Custom Voice Personas
CARTESIA_VOICE_ID_1=1739cd2d-0d7b-4275-8d34-3702a11c85d5
CARTESIA_VOICE_ID_2=e5ecaab2-eded-4425-a1b0-c08d0dde4c50
CARTESIA_VOICE_ID_FEMALE_BRITISH=79a125e8-cd45-4c13-8a67-188112f4dd22


# ──────────────────────────────────────────────────────────────────────────────
# 7. AI CALLING AGENT (OMNI DIMENSION)
# ──────────────────────────────────────────────────────────────────────────────
OMNI_DIMENSION_API_KEY=your_omni_dimension_api_key_here
OMNI_DIMENSION_VOICE_ID=your_omni_dimension_voice_id_here
OMNI_DIMENSION_AGENT_ID=your_omni_dimension_agent_id_here


# ──────────────────────────────────────────────────────────────────────────────
# 8. CODE EXECUTION (JDOODLE COMPILER API)
# ──────────────────────────────────────────────────────────────────────────────
# For remote compilation and execution of Java, Python, Go, C++, etc.
JDOODLE_CLIENT_ID=your_jdoodle_client_id_here
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret_here


# ──────────────────────────────────────────────────────────────────────────────
# 9. CLOUDINARY (MEDIA & RECORDING STORAGE)
# ──────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Days to retain interview recordings before lifecycle cleanup
RECORDING_RETENTION_DAYS=3


# ──────────────────────────────────────────────────────────────────────────────
# 10. TRANSACTIONAL EMAIL (BREVO / SMTP)
# ──────────────────────────────────────────────────────────────────────────────
# Brevo API (Recommended for transactional invitations and reports)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@hireiq.co.in
BREVO_SENDER_NAME="Hire IQ Recruiting"

# Optional: Fallback SMTP server (used if Brevo is not configured)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password


# ──────────────────────────────────────────────────────────────────────────────
# 11. PAYMENT GATEWAYS (RAZORPAY & STRIPE)
# ──────────────────────────────────────────────────────────────────────────────
# Razorpay (India / INR transactions)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe (Global / USD transactions)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret


# ──────────────────────────────────────────────────────────────────────────────
# 12. OMNIDIMENSION (AI VOICE & PHONE CALLING)
# ──────────────────────────────────────────────────────────────────────────────
# OmniDimension API Key (from https://backend.omnidim.io or AWS Secrets Manager)
# Supported names: OMNI_DIMENSION_API_KEY or OMNIDIMENSION_API_KEY
OMNI_DIMENSION_API_KEY=your_omnidimension_api_key_here
OMNI_DIMENSION_AGENT_ID=1
OMNI_DIMENSION_VOICE_ID=
OMNI_CACHE_TTL_SECONDS=15
